  "main": "dist/embed.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/embed.js --minify --sourcemap --target=es2020",
    "build:watch": "esbuild src/index.ts --bundle --outfile=dist/embed.js --sourcemap --target=es2020 --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atkinssk/embed-google-sheet.git"
  },
